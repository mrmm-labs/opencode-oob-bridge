{
  "name": "opencode-oob-bridge",
  "version": "0.50.0",
  "description": "OpenCode plugin that mirrors questions and permission prompts of selected sessions to ntfy and/or Telegram and lets you answer questions from your phone.",
  "keywords": [
    "notifications",
    "ntfy",
    "opencode",
    "plugin",
    "telegram"
  ],
  "homepage": "https://github.com/mrmm-labs/opencode-oob-bridge#readme",
  "bugs": {
    "url": "https://github.com/mrmm-labs/opencode-oob-bridge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmm-labs/opencode-oob-bridge.git"
  },
  "files": [
    "index.js",
    "tui.tsx",
    "sidebar.tsx",
    "miniapp/index.html",
    "miniapp/*.css",
    "miniapp/*.js",
    "!miniapp/*.test.js",
    "dist",
    "oob-bridge.example.jsonc"
  ],
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./tui": "./tui.tsx"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json",
    "test": "OPENCODE_OOB_BRIDGE_CONFIG=/nonexistent/oob-bridge.jsonc OPENCODE_OOB_BRIDGE_DATA=/nonexistent/oob-bridge OPENCODE_OOB_BRIDGE_LOG=/dev/null node --test --test-force-exit --test-timeout=60000 --experimental-strip-types '{src,miniapp}/**/*.test.{ts,js}'",
    "test:real": "OPENCODE_OOB_BRIDGE_CONFIG=/nonexistent/oob-bridge.jsonc OPENCODE_OOB_BRIDGE_DATA=/nonexistent/oob-bridge OPENCODE_OOB_BRIDGE_LOG=/dev/null node --test --test-force-exit --test-timeout=120000 --experimental-strip-types src/real/resume.real.test-util.ts",
    "test:e2e": "OPENCODE_OOB_BRIDGE_CONFIG=/nonexistent/oob-bridge.jsonc OPENCODE_OOB_BRIDGE_DATA=/nonexistent/oob-bridge OPENCODE_OOB_BRIDGE_LOG=/dev/null node --test --test-force-exit --test-timeout=120000 --experimental-strip-types src/e2e.test.ts",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.2",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "solid-js": "^1.9.20",
    "typescript": "^5.0.0",
    "ws": "^8.23.0"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.32.1"
}
