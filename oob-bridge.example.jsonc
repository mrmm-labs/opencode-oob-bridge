// Copy to ~/.config/opencode/oob-bridge.jsonc (or set OPENCODE_OOB_BRIDGE_CONFIG).
// Without this file the plugin does nothing and opens no connection.
{
  // Delivery channels. The key is the channel's name; "type" defaults to the
  // name ("ntfy", "telegram"), so a second instance of a type needs an
  // explicit type, e.g. "phone": { "type": "telegram", ... }.
  "channels": {
    "ntfy": {
      // Your ntfy server.
      "server": "https://ntfy.example.com",

      // Access token: from an environment variable, or from a command's stdout.
      // A token written directly in this file is refused.
      "token": { "env": "OOB_BRIDGE_TOKEN" },
      // "token": { "command": ["pass", "show", "ntfy/opencode"] },

      // Pushes go to "out"; replies come back on "in". Use long random names.
      "topics": { "out": "oc-3k9f2x7q-out", "in": "oc-3k9f2x7q-in" },

      // Buttons carry the token so they work on a server that denies anonymous
      // writes. The token is then readable by anyone who can read "out".
      // false: buttons carry nothing; grant anonymous write-only on "in" instead.
      "actionAuth": true,

      // "enabled": false,
    },

    // A bot from @BotFather. Then run /oob pair telegram in the TUI: it shows a
    // link and QR code, and stores the chat. Or set "chatId" yourself.
    // Telegram bot chats are not end-to-end encrypted: see "redact" below.
    // "telegram": {
    //   "token": { "command": ["pass", "show", "telegram/opencode-bot"] },
    //   // "chatId": 123456789,
    //   // In a forum group: one pinned status card per session topic.
    //   // "statusCard": true,
    //   // Session-end pushes. "finished" is true only when statusCard is false.
    //   // "notify": { "finished": false, "failed": true },
    //   // Topic icon by agent regex or project glob.
    //   // "icons": { "^coordinator$": "🎯", "api*": "🛠" },
    //   // The reaction of each stage (received, queued, sent, steered, done, failed, ignored, held); only emoji Telegram allows bots.
    //   // "agents" replaces the sent emoji for an agent.
    //   // "reactions": { "done": "👌", "failed": "💔", "agents": { "build": "👨‍💻" } },
    //   // Photos and documents taken from the chat.
    //   // "media": { "maxBytes": 10485760, "mimes": ["image/*", "application/pdf", "text/plain"] },
    // },
  },

  // Where pushes go for a session that chose no channel with /oob on <channel>:
  // "all" (every enabled channel), "ntfy" or "telegram".
  "defaultChannel": "all",

  // The sidebar section: "full" (a row each), "compact" (one line) or "off".
  "sidebar": "full",

  // Mirror sessions after this many minutes without input in the TUI.
  "away": { "minutes": 10 },

  // Which sessions mirror while you are away. Any rule matching routes the
  // session; fields in one rule must all match. No rules: every session.
  "rules": [
    { "agent": "^coordinator$" },
    { "directory": "**/my-app" },
    // Exit code 0 routes. Gets OOB_BRIDGE_SESSION, OOB_BRIDGE_AGENT and
    // OOB_BRIDGE_DIRECTORY in its environment.
    // { "command": ["/usr/local/bin/should-notify"] },
  ],

  // Chat with a session from its Telegram topic: off until you run
  // /oob chat on in the TUI, per session. Permissions are never answered
  // from a chat. Telegram is not end-to-end encrypted.
  // "chat": {
  //   // Seconds a message queued behind a busy session waits before it is steered in (0: wait for the turn to end).
  //   "queueSteerSeconds": 30,
  //   "stream": true,
  //   // Shortest time between two edits of a streamed reply, in ms (800 at least).
  //   "streamMs": 1000,
  //   // A prompt to a busy session: "queue" waits for the turn to end, "steer"
  //   // is injected into it. A message starting with ! or /steer always steers.
  //   "delivery": "queue",
  //   "mirror": "replies", // or "remote-only"
  //   // Replies use this instead of the top-level "redact" (default "full"):
  //   // a head:<n> preview limit would cut every reply. "title" carries over.
  //   "redact": "full",
  //   // Never chat with these, even after /oob chat on.
  //   "deny": [{ "directory": "**/payroll" }, { "agent": "^ops$" }],
  //   // /new starts sessions only in these folders (absolute paths). Without
  //   // this, starting sessions from a chat is off.
  //   "projects": {
  //     "shop": { "directory": "/home/me/code/shop", "agent": "build" },
  //   },
  //   // Models /model offers, as provider/model. Default: the models OpenCode
  //   // lists for your providers, twelve at most.
  //   "models": ["anthropic/claude-sonnet-4-5"],
  // },

  // "full", "head:<n>" (first n characters) or "title" (no body).
  // Known secret shapes are masked in every case.
  "redact": "head:300",

  // Push formats. Every kind has a built-in default; set only what you change.
  // Kinds: question, permission, finished, failed, closed (the answered/
  // cancelled update), notice. Fields: title, message, tags, priority (1-5).
  // Placeholders: {{project}} {{agent}} {{subagent}} {{session}} {{sessionID}}
  // {{directory}} {{id}}; question: {{thread}} {{body}} {{hint}};
  // permission: {{action}} {{resources}} {{detail}}; closed: {{title}}
  // {{note}}; notice: {{text}}.
  "messages": {
    // "finished": { "title": "{{project}} done", "priority": 3 },
  },

  // Per use case: the first profile whose agent/directory matches the
  // session's root overrides "messages" (question, permission, finished, failed).
  "profiles": [
    // { "agent": "^coordinator$", "messages": { "question": { "priority": 5 } } },
  ],

  // Only 3 (push only) is supported.
  "permissions": { "tier": 3 },

  // Approvals for local tools over a unix socket (docs/approvals.md). Off by
  // default. A class or caller that is not listed is refused. Levels: 1 tap,
  // 2 tap plus the authenticator code, 3 at the Mac only.
  // "approvals": {
  //   "enabled": true,
  //   "defaultTtl": 120,
  //   "cooldown": 120,
  //   "classes": { "secrets.read": { "level": 1, "channels": ["telegram"] } },
  //   "callers": { "secrets-tool": { "classes": ["secrets.read"] } },
  // },

  // Telegram Mini App (miniapp/README.md): a page for sessions, diffs and forms,
  // served by the core API under /app/. Needs core.bind and a public https
  // address in front of it. Nothing is offered in Telegram until url is set.
  // "miniApp": {
  //   "url": "https://app.example.com/app/",
  //   "link": "https://t.me/examplebot/app",
  // },

  // OpenTelemetry (OTLP/HTTP JSON). Off unless an endpoint is set here or in
  // OTEL_EXPORTER_OTLP_ENDPOINT (and OTEL_EXPORTER_OTLP_HEADERS). Spans and
  // metrics carry ids, kinds, counts and timings: never message text, titles,
  // answers, tokens, chat ids or URLs.
  // "otel": { "endpoint": "http://localhost:4318", "headers": { "authorization": "Bearer ..." } },
}
